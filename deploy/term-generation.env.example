# Server-only example. Never place this file or the populated version in the web root.
TERM_GENERATION_ENABLED=false
TERM_VISUAL_INTENT_ENABLED=true
TERM_PRIVATE_ROOT=/var/lib/psychstats-beta
TERM_PUBLIC_ROOT=/var/www/psy-stats-test
TERM_ORIGIN=https://cdst.site
TERM_API_PREFIX=/psy-stats-test/api/term-explainer/
TERM_FIGURE_QA_DIR=/opt/psychstats-beta/figure-qa
TERM_CJK_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
DEEPSEEK_API_KEY=
TERM_MAX_JOB_CALLS=60
TERM_MAX_DAILY_CALLS=100
TERM_MAX_JOB_TOKENS=800000
TERM_MAX_DAILY_TOKENS=2000000
TERM_MAX_OUTPUT_TOKENS=32768
TERM_MAX_JOB_NETWORK_CALLS=8
TERM_MAX_DAILY_NETWORK_CALLS=12
TERM_MAX_FILE_BYTES=20000000
TERM_MAX_TOTAL_BYTES=40000000
TERM_MAX_FILES=3
TERM_MAX_PAGES=150
TERM_MAX_TEXT_CHARS=120000
TERM_MAX_TASK_SECONDS=7200
TERM_MAX_QUEUE=10
TERM_REQUEST_TIMEOUT=300
